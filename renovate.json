{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "packageRules": [
    {
      "description": "Backstage packages move together",
      "matchPackageNames": [
        "@backstage/**"
      ],
      "groupName": "backstage",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Mend cannot reach Zot",
      "matchPackageNames": [
        "zot.homelab/**"
      ],
      "enabled": false,
      "minimumReleaseAge": "7 days"
    }
  ]
}
